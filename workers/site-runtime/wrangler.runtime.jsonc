{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "netslum-site-runtime",
  "main": "src/dispatcher.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "netslum", "database_id": "a350f70d-3550-4801-87c1-ec9bbdd85993" }],
  "ratelimits": [{ "name": "SITE_RATE", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }]
}
