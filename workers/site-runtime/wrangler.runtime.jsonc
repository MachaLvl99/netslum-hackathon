{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "netslum-site-runtime",
  "main": "src/dispatcher.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "netslum", "database_id": "REPLACE_WITH_D1_ID" }],
  "dispatch_namespaces": [{ "binding": "PRODUCTION_DISPATCHER", "namespace": "netslum-sites-production", "outbound": { "service": "netslum-site-egress" } }],
  "ratelimits": [{ "name": "SITE_RATE", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }]
}
